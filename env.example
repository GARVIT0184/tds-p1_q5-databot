# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:AAExampleTokenGoesHere

# OpenAI API key (use a direct key, not a proxy token that can expire)
OPENAI_API_KEY=sk-your-key-here

# Public URL of this deployed service, no trailing slash
# (used to build the log_url in replies, and for self-ping keep-alive)
BASE_URL=https://your-service.onrender.com

# Model to use — must be frontier-class (gpt-4o or better).
# Small models get real-world stats questions wrong.
MODEL_NAME=gpt-4o
